---
// src/components/MiniGame.astro
// Tahap 3: Interaktif Mini Game
---

<section class="minigame-section" id="game">
    <div class="header-box">
        <span class="label">■ INTERACTIVE ARCHIVE: TRIVIA</span>
        <h2 class="title">Memory Test</h2>
    </div>

    <div class="game-board">
        <div class="question-area">
            <div class="silhouette-box">
                <span class="question-mark">?</span>
            </div>
            <p class="question-text">
                Tebak Momen: Di acara apa Maxine memberikan ekspresi ini?
            </p>
        </div>

        <div class="options-area" id="quiz-options">
            <button class="option-btn" data-answer="wrong">
                <span class="opt-letter">A</span>
                <span class="opt-text">First Live Performance</span>
            </button>
            <button class="option-btn" data-answer="correct">
                <span class="opt-letter">B</span>
                <span class="opt-text">Special Anniversary Event</span>
            </button>
            <button class="option-btn" data-answer="wrong">
                <span class="opt-letter">C</span>
                <span class="opt-text">Behind The Scene MV</span>
            </button>
        </div>

        <div id="game-result" class="result-box hidden"></div>
    </div>
</section>

<style>
    .minigame-section {
        padding: 8rem 2rem;
        background-color: var(--clr-deep-navy);
        color: var(--clr-white);
        max-width: 800px;
        margin: 0 auto;
        font-family: "Poppins", sans-serif;
    }

    .header-box {
        text-align: center;
        margin-bottom: 3rem;
    }
    .label {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        color: var(--clr-silver);
        letter-spacing: 2px;
    }
    .title {
        font-size: 2.5rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 0.5rem;
        text-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
    }

    .game-board {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-global);
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }

    .game-board::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--clr-blue-light),
            transparent
        );
    }

    .silhouette-box {
        width: 200px;
        height: 200px;
        background: #000;
        margin: 0 auto 2rem;
        border-radius: var(--radius-global);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px dashed rgba(255, 255, 255, 0.2);
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
    }

    .question-mark {
        font-size: 5rem;
        color: var(--clr-blue-accent);
        font-family: monospace;
        animation: pulse 2s infinite;
        text-shadow: 0 0 15px var(--clr-blue-accent);
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.5;
            transform: scale(0.95);
        }
        50% {
            opacity: 1;
            transform: scale(1.05);
        }
    }

    .question-text {
        font-size: 1.2rem;
        margin-bottom: 2.5rem;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .options-area {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        max-width: 500px;
        margin: 0 auto;
    }

    .option-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--clr-white);
        padding: 1rem 1.5rem;
        font-family: inherit;
        font-size: 1.1rem;
        cursor: pointer;
        border-radius: var(--radius-global);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 15px;
        text-align: left;
    }

    .option-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: var(--clr-blue-light);
        transform: translateX(10px);
    }

    .opt-letter {
        font-family: "Courier New", monospace;
        background: rgba(255, 255, 255, 0.1);
        padding: 5px 12px;
        border-radius: 4px;
        font-weight: bold;
        color: var(--clr-blue-light);
        flex-shrink: 0;
    }

    .opt-text {
        flex-grow: 1;
    }

    .option-btn.correct {
        background: rgba(16, 185, 129, 0.1);
        border-color: #10b981;
        color: #fff;
        transform: translateX(0);
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
    }
    .option-btn.correct .opt-letter {
        background: #10b981;
        color: #fff;
    }

    .option-btn.wrong {
        background: rgba(239, 68, 68, 0.1);
        border-color: #ef4444;
        color: #fff;
        transform: translateX(0);
    }
    .option-btn.wrong .opt-letter {
        background: #ef4444;
        color: #fff;
    }

    .result-box {
        margin-top: 2.5rem;
        padding: 1.5rem;
        border-radius: var(--radius-global);
        font-weight: 600;
        font-size: 1.2rem;
        animation: slideUp 0.4s ease-out;
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .result-box.success {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid #10b981;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
    }
    .result-box.error {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid #ef4444;
    }
    .hidden {
        display: none;
    }
</style>

<script>
    const buttons = document.querySelectorAll(".option-btn");
    const resultBox = document.getElementById("game-result");

    buttons.forEach((btn) => {
        btn.addEventListener("click", function () {
            buttons.forEach((b) => b.classList.remove("correct", "wrong"));
            resultBox.classList.remove("hidden", "success", "error");

            const isCorrect = this.getAttribute("data-answer") === "correct";

            if (isCorrect) {
                this.classList.add("correct");
                resultBox.textContent = "✔ Benar! Kamu Maxine Expert 😎";
                resultBox.classList.add("success");
            } else {
                this.classList.add("wrong");
                resultBox.textContent = "✖ Belum tepat, coba lagi!";
                resultBox.classList.add("error");
            }
        });
    });
</script>
