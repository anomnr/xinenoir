---
// src/components/MiniGame.astro
// Tahap 3: Interaktif Mini Game (QnA)
---

<section class="minigame-section" id="game">
    <div class="header-box">
        <span class="label">■ INTERACTIVE ARCHIVE: TRIVIA</span>
        <h2 class="title">Memory Test</h2>
    </div>

    <div class="game-board">
        <div id="quiz-area">
            <div class="question-area">
                <div class="silhouette-box">
                    <span class="question-mark">?</span>
                </div>
                <p class="question-text" id="question-text">
                    Loading question...
                </p>
            </div>
            <div class="options-area" id="quiz-options">
                <!-- Opsi jawaban akan dirender di sini via JS -->
            </div>
        </div>

        <div id="result-area" class="result-box hidden">
            <div class="score-display" id="result-score">0/6</div>
            <p class="result-message" id="result-message">Message</p>
            <button id="restart-btn" class="restart-btn">Main Lagi</button>
        </div>
    </div>
</section>

<style>
    .minigame-section {
        padding: 8rem 2rem;
        background-color: var(--clr-deep-navy);
        color: var(--clr-white);
        max-width: 800px;
        margin: 0 auto;
        font-family: var(--font-body);
    }

    .header-box {
        text-align: center;
        margin-bottom: 3rem;
    }
    .label {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        color: var(--clr-silver);
        letter-spacing: 2px;
    }
    .title {
        font-size: 2.5rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 0.5rem;
        text-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
    }

    .game-board {
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: var(--radius-global);
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }

    .game-board::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--clr-blue-light),
            transparent
        );
    }

    .silhouette-box {
        width: 180px;
        height: 180px;
        background: rgba(0, 0, 0, 0.5);
        margin: 0 auto 2rem;
        border-radius: var(--radius-global);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px dashed rgba(255, 255, 255, 0.2);
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
    }

    .question-mark {
        font-size: 5rem;
        color: var(--clr-blue-accent);
        font-family: monospace;
        animation: pulse 2s infinite;
        text-shadow: 0 0 15px var(--clr-blue-accent);
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.5;
            transform: scale(0.95);
        }
        50% {
            opacity: 1;
            transform: scale(1.05);
        }
    }

    .question-text {
        font-size: 1.2rem;
        margin-bottom: 2.5rem;
        font-weight: 500;
        letter-spacing: 1px;
        min-height: 3.6rem;
    }

    .options-area {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 500px;
        margin: 0 auto;
    }

    :global(.option-btn) {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--clr-white);
        padding: 1rem 1.5rem;
        font-family: inherit;
        font-size: 1.1rem;
        cursor: pointer;
        border-radius: var(--radius-global);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 15px;
        text-align: left;
    }

    :global(.option-btn:hover:not(:disabled)) {
        background: rgba(255, 255, 255, 0.15);
        border-color: var(--clr-blue-light);
        transform: translateX(10px);
    }

    :global(.option-btn:disabled) {
        cursor: not-allowed;
    }

    :global(.opt-letter) {
        font-family: "Courier New", monospace;
        background: rgba(255, 255, 255, 0.1);
        padding: 5px 12px;
        border-radius: 4px;
        font-weight: bold;
        color: var(--clr-blue-light);
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    :global(.opt-text) {
        flex-grow: 1;
    }

    /* Target state classes with important to override specificity */
    :global(.option-btn.correct) {
        background-color: #10B981 !important;
        color: white !important;
        border-color: #10B981 !important;
    }
    :global(.option-btn.correct .opt-letter) {
        background-color: rgba(255, 255, 255, 0.2) !important;
        color: white !important;
    }

    :global(.option-btn.incorrect) {
        background-color: #EF4444 !important;
        color: white !important;
        border-color: #EF4444 !important;
    }
    :global(.option-btn.incorrect .opt-letter) {
        background-color: rgba(255, 255, 255, 0.2) !important;
        color: white !important;
    }

    .result-box {
        animation: slideUp 0.5s ease-out;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .score-display {
        font-size: 4rem;
        font-family: "Courier New", monospace;
        font-weight: bold;
        color: var(--clr-blue-light);
        text-shadow: 0 0 20px rgba(96, 165, 250, 0.5);
    }

    .result-message {
        font-size: 1.3rem;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .restart-btn {
        background: var(--clr-blue-accent);
        color: var(--clr-white);
        border: none;
        padding: 1rem 2.5rem;
        font-family: inherit;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        border-radius: var(--radius-global);
        transition: all 0.3s ease;
        margin-top: 1rem;
        white-space: nowrap;
    }

    .restart-btn:hover {
        background: var(--clr-blue-light);
        transform: scale(0.98);
    }

    .restart-btn:active {
        transform: scale(0.95);
    }

    .hidden {
        display: none !important;
    }
    
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    const questions = [
        {
            question: "Di Tanggal berapa Maxine berulang tahun?",
            options: [
                { text: "10 February 2013", isCorrect: false },
                { text: "6 juni 2012", isCorrect: false },
                { text: "2 desember 2011", isCorrect: true }
            ]
        },
        {
            question: "Seperti apakah jiko nya Maxine?",
            options: [
                { text: "Faith, Trust, and Magical pixie dust.", isCorrect: true },
                { text: "Sekali senyum langsung buatmu jatuh cinta", isCorrect: false },
                { text: "Datang bawa tawa, pulang bawa rindu.", isCorrect: false }
            ]
        },
        {
            question: "Darimanakah Maxine berasal?",
            options: [
                { text: "Jakarta", isCorrect: true },
                { text: "Garut", isCorrect: false },
                { text: "Surabaya", isCorrect: false }
            ]
        },
        {
            question: "Sebutkan Zodiac nya Maxine!",
            options: [
                { text: "Sagittarius", isCorrect: true },
                { text: "Pisces", isCorrect: false },
                { text: "Libra", isCorrect: false }
            ]
        },
        {
            question: "Setlist Apa Yang di bawakan Maxine?",
            options: [
                { text: "Junjou Shugi", isCorrect: false },
                { text: "Pajama Drive", isCorrect: true },
                { text: "Tenshi no Shippo", isCorrect: false }
            ]
        },
        {
            question: "Sebutkan nama panjang Maxine!",
            options: [
                { text: "Maxine Van Irwan", isCorrect: false },
                { text: "Maxine Gabriella", isCorrect: false },
                { text: "Maxine Faye Lee", isCorrect: true }
            ]
        }
    ];

    let currentQuestionIndex = 0;
    let score = 0;

    const quizArea = document.getElementById("quiz-area");
    const resultArea = document.getElementById("result-area");
    const questionText = document.getElementById("question-text");
    const optionsContainer = document.getElementById("quiz-options");
    const resultScore = document.getElementById("result-score");
    const resultMessage = document.getElementById("result-message");
    const restartBtn = document.getElementById("restart-btn");

    function renderQuestion() {
        // Hapus opsi sebelumnya
        optionsContainer.innerHTML = "";
        
        const qData = questions[currentQuestionIndex];
        questionText.textContent = qData.question;
        
        const letters = ["A", "B", "C"];

        qData.options.forEach((opt, index) => {
            const btn = document.createElement("button");
            btn.className = "option-btn";
            
            const spanLetter = document.createElement("span");
            spanLetter.className = "opt-letter";
            spanLetter.textContent = letters[index];
            
            const spanText = document.createElement("span");
            spanText.className = "opt-text";
            spanText.textContent = opt.text;
            
            btn.appendChild(spanLetter);
            btn.appendChild(spanText);
            
            btn.addEventListener("click", () => handleAnswer(opt.isCorrect, btn));
            optionsContainer.appendChild(btn);
        });
    }

    function handleAnswer(isCorrect, clickedBtn) {
        // Nonaktifkan semua tombol agar tidak bisa di klik ganda
        const allBtns = optionsContainer.querySelectorAll(".option-btn");
        allBtns.forEach(b => b.disabled = true);

        if (isCorrect) {
            clickedBtn.classList.add("correct");
            score++;
        } else {
            clickedBtn.classList.add("incorrect");
        }

        // Jeda 1 detik sebelum lanjut
        setTimeout(() => {
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                renderQuestion();
            } else {
                showResult();
            }
        }, 1000);
    }

    function showResult() {
        quizArea.classList.add("hidden");
        resultArea.classList.remove("hidden");

        resultScore.textContent = `${score}/6`;

        if (score === 6) {
            resultMessage.textContent = "6/6 Wah kamu fans sejati Maxine! 😎";
        } else if (score >= 4) {
            resultMessage.textContent = `${score}/6 Keren! Pengetahuanmu tentang Maxine sudah mantap! ✨`;
        } else if (score >= 1) {
            resultMessage.textContent = `${score}/6 Lumayan, tapi yuk kenal Maxine lebih jauh lagi! 😉`;
        } else {
            resultMessage.textContent = "0/6 Belum tepat, coba lagi ya! 🥺";
        }
    }

    function restartQuiz() {
        currentQuestionIndex = 0;
        score = 0;
        resultArea.classList.add("hidden");
        quizArea.classList.remove("hidden");
        renderQuestion();
    }

    restartBtn.addEventListener("click", restartQuiz);

    // Inisialisasi awal
    renderQuestion();
</script>
