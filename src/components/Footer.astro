---
// src/components/Footer.astro
// Tahap 4: Footer
---

<footer class="site-footer">
    <div class="footer-content">
        <div class="brand">
            <div class="logo-mark">N</div>
            <h3>XINENOIR</h3>
            <p>echoes in the dark. where silence speaks.</p>
        </div>

        <div class="nav-grid">
            <div class="nav-column">
                <span class="link-label">■ EXPLORE</span>
                <a href="/">Home</a>
                <a href="/gallery">Gallery</a>
                <a href="/music">Music</a>
                <a href="/countdown">Countdown</a>
            </div>
            <div class="nav-column">
                <span class="link-label">■ INTERACT</span>
                <a href="/game">Game</a>
                <a href="/#quotes">Quotes</a>
                <a href="/notes">Notes</a>
                <a href="/collection">Collection</a>
            </div>
            <div class="nav-column">
                <span class="link-label">■ CONNECT</span>
                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
                <a href="https://x.com" target="_blank" rel="noopener noreferrer">Twitter/X ↗</a>
                <a href="https://youtube.com" target="_blank" rel="noopener noreferrer">YouTube ↗</a>
                <a href="/#community">Community</a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="hashtags">
            <span class="hashtag">#Trustinfaye</span>
            <span class="hashtag">#XineNoir</span>
        </div>
        <span class="copyright"
            >SYSTEM LOG: © 2026 XINENOIR ARCHIVE. ALL RIGHTS RESERVED.</span
        >
    </div>
</footer>

<style>
    .site-footer {
        background: linear-gradient(135deg, var(--clr-deep-navy) 0%, rgba(15, 30, 80, 0.8) 50%, rgba(37, 99, 235, 0.3) 100%);
        color: var(--clr-white);
        padding: 6rem 4rem 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        position: relative;
    }

    .footer-content {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 4rem;
        max-width: 1200px;
        margin: 0 auto 4rem;
    }

    .brand {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .logo-mark {
        font-family: 'Times New Roman', Times, serif;
        font-size: 2.5rem;
        font-style: italic;
        color: var(--clr-blue-light);
        margin-bottom: -10px;
        opacity: 0.5;
    }

    .brand h3 {
        font-size: 2.5rem;
        letter-spacing: 0.15em;
        font-weight: 700;
        margin: 0;
    }
    
    .brand p {
        font-family: "Courier New", monospace;
        color: var(--clr-silver);
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .nav-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .nav-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .link-label {
        font-family: "Courier New", monospace;
        color: var(--clr-blue-light);
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        letter-spacing: 2px;
        font-weight: bold;
    }

    .nav-column a {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: var(--font-body);
    }
    
    .nav-column a:hover {
        color: var(--clr-white);
        transform: translateX(5px);
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    .footer-bottom {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 2rem;
        font-family: "Courier New", monospace;
    }

    .hashtags {
        display: flex;
        gap: 1rem;
    }

    .hashtag {
        font-weight: bold;
        color: var(--clr-white);
        background: rgba(37, 99, 235, 0.2);
        border: 1px solid rgba(37, 99, 235, 0.5);
        padding: 5px 15px;
        font-size: 0.85rem;
        letter-spacing: 2px;
        border-radius: var(--radius-global);
        transition: all 0.3s ease;
    }

    .hashtag:hover {
        background: var(--clr-blue-accent);
        box-shadow: 0 0 15px rgba(37, 99, 235, 0.6);
    }

    .copyright {
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.75rem;
        letter-spacing: 1px;
    }

    @media (max-width: 900px) {
        .footer-content {
            grid-template-columns: 1fr;
            text-align: center;
        }
        
        .brand {
            align-items: center;
        }

        .nav-grid {
            grid-template-columns: repeat(2, 1fr);
            text-align: left;
        }
    }

    @media (max-width: 600px) {
        .nav-grid {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .nav-column a:hover {
            transform: translateX(0);
        }

        .footer-bottom {
            flex-direction: column;
            gap: 1.5rem;
            text-align: center;
        }
        .site-footer {
            padding: 4rem 2rem 2rem;
        }
    }
</style>
