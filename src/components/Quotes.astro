---
// src/components/Quotes.astro
// Tahap 3: Video Reveal Card
---

<section class="quotes-section">
    <div class="quotes-container">
        <div class="quote-card" id="quoteCard">
            <div class="card-inner" id="cardInner">
                <div class="card-front" id="cardFront">
                    <p class="quote-text">"Butuh semangat hari ini?"</p>
                    <div class="tap-indicator">Tap the card ↓</div>
                </div>

                <div class="card-back" id="cardBack">
                    <video id="maxineVid" width="100%" height="100%" controls>
                        <source
                            src="https://www.w3schools.com/html/mov_bbb.mp4"
                            type="video/mp4"
                        />
                        Your browser does not support HTML video.
                    </video>
                    <button class="close-vid-btn" id="closeVid">Tutup Video</button>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .quotes-section {
        padding: 6rem 2rem 10rem;
        background-color: var(--clr-deep-navy);
        display: flex;
        justify-content: center;
        perspective: 1200px;
        position: relative;
        z-index: 5;
    }

    .quotes-container {
        width: 100%;
        max-width: 600px;
    }

    .quote-card {
        width: 100%;
        min-height: 350px;
        background-color: transparent;
        perspective: 1000px;
        cursor: pointer;
    }

    .card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 350px;
        text-align: center;
        transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform-style: preserve-3d;
    }

    .quote-card.flipped .card-inner {
        transform: rotateY(180deg);
    }

    .card-front, .card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        border-radius: var(--radius-global);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .card-front {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        padding: 3rem;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .quote-card:hover .card-front {
        border-color: var(--clr-blue-accent);
        box-shadow: 0 15px 40px rgba(37, 99, 235, 0.2);
    }

    .quote-text {
        font-family: "Poppins", sans-serif;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 500;
        font-style: italic;
        color: var(--clr-white);
        margin-bottom: 2rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .tap-indicator {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        color: var(--clr-blue-light);
        animation: bounce 2s infinite;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }

    .card-back {
        background: #000;
        transform: rotateY(180deg);
        justify-content: space-between;
    }

    #maxineVid {
        width: 100%;
        height: calc(100% - 50px);
        object-fit: cover;
        filter: grayscale(100%) contrast(120%) brightness(0.8);
    }

    .close-vid-btn {
        width: 100%;
        height: 50px;
        background: rgba(255,255,255,0.05);
        color: var(--clr-silver);
        border: none;
        border-top: 1px solid rgba(255,255,255,0.1);
        font-family: "Courier New", monospace;
        letter-spacing: 2px;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .close-vid-btn:hover {
        background: rgba(255,255,255,0.1);
        color: var(--clr-white);
    }
    
</style>

<script>
    const quoteCard = document.getElementById("quoteCard");
    const closeVidBtn = document.getElementById("closeVid");
    const maxineVid = document.getElementById("maxineVid") as HTMLVideoElement;

    // Flip card to back
    quoteCard.addEventListener("click", function(e) {
        // Prevent flipping if we click the close button
        if(e.target === closeVidBtn) return;
        
        if (!this.classList.contains('flipped')) {
            this.classList.add("flipped");
            if (maxineVid) {
                setTimeout(() => { 
                    const playPromise = maxineVid.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(err => console.log('Autoplay prevented:', err));
                    }
                }, 400); // play after flip
            }
        }
    });

    // Flip card to front
    closeVidBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (maxineVid) {
            maxineVid.pause();
            maxineVid.currentTime = 0;
        }
        quoteCard.classList.remove("flipped");
    });
</script>
