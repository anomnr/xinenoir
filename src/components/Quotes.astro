---
// src/components/Quotes.astro
// Tahap 3: Video Reveal Card
---

<section class="quotes-section" id="quotes">
    <div class="quotes-container">
        <div class="quote-card" id="quoteCard">
            <div class="card-inner" id="cardInner">
                <div class="card-front" id="cardFront">
                    <p class="quote-text">"Butuh semangat hari ini?"</p>
                    <div class="tap-indicator">Tap the card ↓</div>
                </div>

                <div class="card-back" id="cardBack">
                    <video id="maxineVid" width="100%" height="100%" playsinline>
                        Your browser does not support HTML video.
                    </video>
                    <button class="close-vid-btn" id="closeVid">Tutup Video</button>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @font-face {
        font-family: 'Archivo';
        src: url('/font/Archivo_Complete/Fonts/WEB/fonts/Archivo-SemiBold.woff2') format('woff2'),
             url('/font/Archivo_Complete/Fonts/WEB/fonts/Archivo-SemiBold.woff') format('woff');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
    }

    .quotes-section {
        padding: 6rem 2rem 10rem;
        background-color: transparent;
        display: flex;
        justify-content: center;
        perspective: 1200px;
        position: relative;
        z-index: 5;
    }

    .quotes-container {
        width: 100%;
        max-width: 600px;
        display: flex;
        justify-content: center;
    }

    .quote-card {
        width: 100%;
        max-width: 600px;
        min-height: 350px;
        margin: 0 auto;
        background-color: transparent;
        perspective: 1000px;
        cursor: pointer;
        transition: max-width 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                    min-height 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .quote-card.flipped {
        max-width: 320px;
        min-height: 620px; /* Fits 320px wide 9:16 video + 50px button */
    }

    .card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform-style: preserve-3d;
    }

    .quote-card.flipped .card-inner {
        transform: rotateY(180deg);
    }

    .card-front, .card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        border-radius: var(--radius-global, 12px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .card-front {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.15) 0%, rgba(15, 23, 42, 0.8) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-left: 3px solid #3B82F6;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        padding: 2rem;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .quote-card:hover .card-front {
        border-color: var(--clr-blue-accent);
        box-shadow: 0 15px 40px rgba(37, 99, 235, 0.2);
    }

    .quote-text {
        font-family: 'Archivo', sans-serif;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 600;
        font-style: normal;
        color: var(--clr-white);
        margin-bottom: 2rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        line-height: 1.4;
    }

    .tap-indicator {
        font-family: "Courier New", monospace;
        font-size: 0.85rem;
        color: var(--clr-blue-light);
        animation: bounce 2s infinite;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: auto;
        margin-bottom: 1rem;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }

    .card-back {
        background: #000;
        transform: rotateY(180deg);
        justify-content: space-between;
    }

    #maxineVid {
        width: 100%;
        height: calc(100% - 50px);
        object-fit: cover;
        filter: grayscale(100%) contrast(120%) brightness(0.8);
    }

    .close-vid-btn {
        width: 100%;
        height: 50px;
        background: rgba(255,255,255,0.05);
        color: var(--clr-silver);
        border: none;
        border-top: 1px solid rgba(255,255,255,0.1);
        font-family: "Courier New", monospace;
        letter-spacing: 2px;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .close-vid-btn:hover {
        background: rgba(255,255,255,0.1);
        color: var(--clr-white);
    }
    
</style>

<script>
    const quoteCard = document.getElementById("quoteCard");
    const closeVidBtn = document.getElementById("closeVid");
    const maxineVid = document.getElementById("maxineVid") as HTMLVideoElement;

    const videoUrls = [
        "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896048/quote_1.mp4",
        "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896044/quote_2.mp4",
        "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896062/quote_3.mp4",
        "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896055/quote_4.mp4",
        "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896040/quote_5.mp4"
    ];

    // --- Achievement Tracking ---
    if (maxineVid) {
        maxineVid.addEventListener('ended', () => {
            if (!localStorage.getItem('achv_quote')) {
                localStorage.setItem('achv_quote', 'true');
                window.dispatchEvent(new Event('updateCollection'));
            }
        });
    }

    // Flip card to back
    quoteCard?.addEventListener("click", function(e) {
        // Prevent flipping if we click the close button
        if(e.target === closeVidBtn) return;
        
        if (!this.classList.contains('flipped')) {
            if (maxineVid) {
                const randomVid = videoUrls[Math.floor(Math.random() * videoUrls.length)];
                maxineVid.src = randomVid;
                maxineVid.load();
            }

            this.classList.add("flipped");
            if (maxineVid) {
                setTimeout(() => { 
                    const playPromise = maxineVid.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(err => console.log('Autoplay prevented:', err));
                    }
                }, 400); // play after flip
            }
        }
    });

    // Flip card to front
    closeVidBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (maxineVid) {
            maxineVid.pause();
            maxineVid.currentTime = 0;
        }
        quoteCard?.classList.remove("flipped");
    });
</script>
