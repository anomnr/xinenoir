---
// src/components/Gallery.astro
// Tahap 2: Gallery List dengan Cinematic Hover Image & Modal
---

<section class="gallery-section" id="gallery">
    <div class="gallery-header">
        <h2 class="title">Visual Archives</h2>
        <p class="subtitle">echoes mapped in light.</p>
    </div>

    <div class="bento-grid">
        <!-- Main Highlight -->
        <a href="#" class="bento-card highlight">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[01]</span>
                <h3 class="bento-title">JKT48 & Related Archive</h3>
                <p class="bento-desc">August 2026</p>
            </div>
        </a>

        <!-- Secondary Item -->
        <a href="#" class="bento-card alt-1">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[02]</span>
                <h3 class="bento-title">Fancam Maxine</h3>
                <p class="bento-desc">July 2026</p>
            </div>
        </a>

        <!-- Tertiary Item -->
        <a href="#" class="bento-card alt-2">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[03]</span>
                <h3 class="bento-title">Special Performance</h3>
                <p class="bento-desc">June 2026</p>
            </div>
        </a>
    </div>

    <!-- Cinematic Lightbox Modal -->
    <div id="gallery-modal" class="gallery-modal">
        <span class="modal-close">&times; CLOSE</span>
        <img id="lightbox-img" src="" alt="Gallery Image Enlarge">
    </div>
</section>

<style>
    .gallery-section {
        padding: 8rem 2rem;
        background-color: transparent;
        color: var(--clr-white);
        max-width: 1400px;
        margin: 0 auto;
    }

    .gallery-header {
        margin-bottom: 4rem;
        text-align: left;
    }

    .title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .subtitle {
        font-size: 1rem;
        color: var(--clr-silver);
        letter-spacing: 0.2em;
        font-family: "Courier New", Courier, monospace;
        margin-top: 0.5rem;
    }

    .bento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 300px;
        gap: 1.5rem;
    }

    .bento-card {
        position: relative;
        border-radius: var(--radius-global);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        text-decoration: none;
        color: var(--clr-white);
        border: 1px solid rgba(255, 255, 255, 0.1);
        group: card;
    }

    .highlight {
        grid-column: span 2;
        grid-row: span 2;
    }

    .alt-1 {
        grid-column: span 1;
        grid-row: span 1;
    }

    .alt-2 {
        grid-column: span 1;
        grid-row: span 1;
    }

    .bento-img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-position: center;
        background-size: cover;
        z-index: 0;
        transition: transform 0.8s ease, filter 0.8s ease;
        filter: grayscale(100%) contrast(110%) brightness(0.6);
    }

    .highlight .bento-img { background-image: url("https://images.unsplash.com/photo-1516280440502-613ecfbb6f27?q=80&w=1200&auto=format&fit=crop"); }
    .alt-1 .bento-img { background-image: url("https://images.unsplash.com/photo-1598387993441-a3637e10669d?q=80&w=800&auto=format&fit=crop"); }
    .alt-2 .bento-img { background-image: url("https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=800&auto=format&fit=crop"); }

    .bento-card:hover .bento-img {
        transform: scale(1.05);
        filter: grayscale(0%) contrast(100%) brightness(0.8);
    }

    .bento-content {
        position: relative;
        z-index: 1;
        padding: 2rem;
        background: linear-gradient(to top, rgba(15,23,42,0.95) 0%, rgba(15,23,42,0) 100%);
        transition: transform 0.4s ease;
    }

    .bento-badge {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        color: var(--clr-blue-light);
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    .bento-title {
        font-size: clamp(1.2rem, 3vw, 2rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .bento-desc {
        font-family: "Courier New", monospace;
        color: var(--clr-silver);
        font-size: 0.9rem;
    }

    @media (max-width: 900px) {
        .bento-grid {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
        }
        .highlight, .alt-1, .alt-2 {
            grid-column: 1;
            grid-row: auto;
        }
        .highlight {
            min-height: 400px;
        }
        .alt-1, .alt-2 {
            min-height: 250px;
        }
    }

    /* Cinematic Modal Styles */
    .gallery-modal {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        z-index: 9999;
        display: flex; flex-direction: column; justify-content: center; align-items: center;
        opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
    }

    .gallery-modal.modal-active {
        opacity: 1;
        pointer-events: all;
    }

    .modal-close {
        position: absolute;
        top: 30px;
        right: 40px;
        color: var(--clr-white);
        font-family: "Courier New", monospace;
        font-size: 1.2rem;
        letter-spacing: 2px;
        cursor: pointer;
        z-index: 10000;
        transition: color 0.3s ease;
    }

    .modal-close:hover {
        color: var(--clr-blue-accent);
    }
    
    .gallery-modal img {
        max-width: 90%;
        max-height: 90vh;
        border-radius: var(--radius-global);
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        transform: scale(0.95);
        transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .gallery-modal.modal-active img {
        transform: scale(1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.bento-card');
        const modal = document.getElementById('gallery-modal');
        const modalImg = document.getElementById('lightbox-img');
        const closeBtn = document.querySelector('.modal-close');

        if (!modal || !modalImg || !closeBtn) return;

        cards.forEach(card => {
            card.addEventListener('click', (e) => {
                e.preventDefault();
                const bgImg = card.querySelector('.bento-img') as HTMLElement;
                if (!bgImg) return;
                
                const style = window.getComputedStyle(bgImg);
                let url = style.backgroundImage;
                // Extract URL from url("...")
                if (url && url !== 'none') {
                    url = url.slice(4, -1).replace(/"/g, "");
                    (modalImg as HTMLImageElement).src = url;
                    modal.classList.add('modal-active');
                }
            });
        });

        closeBtn.addEventListener('click', () => {
            modal.classList.remove('modal-active');
        });

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.remove('modal-active');
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('modal-active')) {
                modal.classList.remove('modal-active');
            }
        });
    });
</script>
