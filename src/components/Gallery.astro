---
// src/components/Gallery.astro
import { Image } from 'astro:assets';

// Load all images from the assets/images directory
const imagesGlob = import.meta.glob('../assets/images/*.{jpg,jpeg,png}', { eager: true });
const images = Object.values(imagesGlob).map((img: any) => img.default);
---

<section class="gallery-section" id="gallery">
    <div class="gallery-header">
        <h2 class="title">Visual Archives</h2>
        <p class="subtitle">echoes mapped in light.</p>
    </div>

    <div class="masonry-grid">
        {images.map((img, index) => (
            <a href="#" class="gallery-card" data-full={img.src}>
                <Image src={img} alt={`Maxine Archive ${index + 1}`} class="gallery-img" />
                <div class="card-overlay">
                    <span class="view-text">VIEW FULL</span>
                </div>
            </a>
        ))}
    </div>

    <!-- Cinematic Lightbox Modal -->
    <div id="gallery-modal" class="gallery-modal">
        <span class="modal-close">&times; CLOSE</span>
        <img id="lightbox-img" src="" alt="Gallery Image Enlarge">
    </div>
</section>

<style>
    .gallery-section {
        padding: 8rem 2rem;
        background-color: transparent;
        color: var(--clr-white);
        max-width: 1400px;
        margin: 0 auto;
    }

    .gallery-header {
        margin-bottom: 4rem;
        text-align: left;
    }

    .title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .subtitle {
        font-size: 1rem;
        color: var(--clr-silver);
        letter-spacing: 0.2em;
        font-family: "Courier New", Courier, monospace;
        margin-top: 0.5rem;
    }

    .masonry-grid {
        column-count: 3;
        column-gap: 1.5rem;
    }

    .gallery-card {
        display: block;
        position: relative;
        border-radius: var(--radius-global);
        overflow: hidden;
        margin-bottom: 1.5rem;
        break-inside: avoid;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        background-color: rgba(15,23,42,0.5); /* fallback */
    }

    .gallery-img {
        width: 100%;
        display: block;
        height: auto;
        filter: grayscale(100%) contrast(110%) brightness(0.6);
        transition: transform 0.8s ease, filter 0.8s ease;
    }

    .gallery-card:hover .gallery-img {
        transform: scale(1.05);
        filter: grayscale(0%) contrast(100%) brightness(0.9);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
    }

    .gallery-card:hover .card-overlay {
        opacity: 1;
    }

    .view-text {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        letter-spacing: 2px;
        color: var(--clr-white);
        border: 1px solid rgba(255, 255, 255, 0.5);
        padding: 0.6rem 1.2rem;
        border-radius: 4px;
        backdrop-filter: blur(4px);
        transform: translateY(10px);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .gallery-card:hover .view-text {
        transform: translateY(0);
        border-color: var(--clr-white);
        background: rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 1024px) {
        .masonry-grid {
            column-count: 2;
        }
    }

    @media (max-width: 640px) {
        .masonry-grid {
            column-count: 1;
        }
    }

    /* Cinematic Modal Styles */
    .gallery-modal {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        z-index: 9999;
        display: flex; flex-direction: column; justify-content: center; align-items: center;
        opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
    }

    .gallery-modal.modal-active {
        opacity: 1;
        pointer-events: all;
    }

    .modal-close {
        position: absolute;
        top: 30px;
        right: 40px;
        color: var(--clr-white);
        font-family: "Courier New", monospace;
        font-size: 1.2rem;
        letter-spacing: 2px;
        cursor: pointer;
        z-index: 10000;
        transition: color 0.3s ease;
    }

    .modal-close:hover {
        color: var(--clr-blue-accent);
    }
    
    .gallery-modal img {
        max-width: 90%;
        max-height: 90vh;
        border-radius: var(--radius-global);
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        transform: scale(0.95);
        transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        object-fit: contain;
    }

    .gallery-modal.modal-active img {
        transform: scale(1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.gallery-card');
        const modal = document.getElementById('gallery-modal');
        const modalImg = document.getElementById('lightbox-img');
        const closeBtn = document.querySelector('.modal-close');

        if (!modal || !modalImg || !closeBtn) return;

        cards.forEach(card => {
            card.addEventListener('click', (e) => {
                e.preventDefault();
                const fullSrc = card.getAttribute('data-full');
                if (fullSrc) {
                    (modalImg as HTMLImageElement).src = fullSrc;
                    modal.classList.add('modal-active');
                }
            });
        });

        closeBtn.addEventListener('click', () => {
            modal.classList.remove('modal-active');
        });

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.remove('modal-active');
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('modal-active')) {
                modal.classList.remove('modal-active');
            }
        });
    });
</script>
