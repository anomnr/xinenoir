---
// src/components/Gallery.astro
// Tahap 2: Gallery List dengan Cinematic Hover Image
---

<section class="gallery-section" id="gallery">
    <div class="gallery-header">
        <h2 class="title">Visual Archives</h2>
        <p class="subtitle">echoes mapped in light.</p>
    </div>

    <div class="bento-grid">
        <!-- Main Highlight -->
        <a href="#" class="bento-card highlight">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[01]</span>
                <h3 class="bento-title">JKT48 & Related Archive</h3>
                <p class="bento-desc">August 2026</p>
            </div>
        </a>

        <!-- Secondary Item -->
        <a href="#" class="bento-card alt-1">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[02]</span>
                <h3 class="bento-title">Fancam Maxine</h3>
                <p class="bento-desc">July 2026</p>
            </div>
        </a>

        <!-- Tertiary Item -->
        <a href="#" class="bento-card alt-2">
            <div class="bento-img"></div>
            <div class="bento-content">
                <span class="bento-badge">[03]</span>
                <h3 class="bento-title">Special Performance</h3>
                <p class="bento-desc">June 2026</p>
            </div>
        </a>
    </div>
</section>

<style>
    .gallery-section {
        padding: 8rem 2rem;
        background-color: var(--clr-deep-navy);
        color: var(--clr-white);
        max-width: 1400px;
        margin: 0 auto;
    }

    .gallery-header {
        margin-bottom: 4rem;
        text-align: left;
    }

    .title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .subtitle {
        font-size: 1rem;
        color: var(--clr-silver);
        letter-spacing: 0.2em;
        font-family: "Courier New", Courier, monospace;
        margin-top: 0.5rem;
    }

    .bento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 300px;
        gap: 1.5rem;
    }

    .bento-card {
        position: relative;
        border-radius: var(--radius-global);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        text-decoration: none;
        color: var(--clr-white);
        border: 1px solid rgba(255, 255, 255, 0.1);
        group: card;
    }

    .highlight {
        grid-column: span 2;
        grid-row: span 2;
    }

    .alt-1 {
        grid-column: span 1;
        grid-row: span 1;
    }

    .alt-2 {
        grid-column: span 1;
        grid-row: span 1;
    }

    .bento-img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-position: center;
        background-size: cover;
        z-index: 0;
        transition: transform 0.8s ease, filter 0.8s ease;
        filter: grayscale(100%) contrast(110%) brightness(0.6);
    }

    .highlight .bento-img { background-image: url("https://images.unsplash.com/photo-1516280440502-613ecfbb6f27?q=80&w=1200&auto=format&fit=crop"); }
    .alt-1 .bento-img { background-image: url("https://images.unsplash.com/photo-1598387993441-a3637e10669d?q=80&w=800&auto=format&fit=crop"); }
    .alt-2 .bento-img { background-image: url("https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=800&auto=format&fit=crop"); }

    .bento-card:hover .bento-img {
        transform: scale(1.05);
        filter: grayscale(0%) contrast(100%) brightness(0.8);
    }

    .bento-content {
        position: relative;
        z-index: 1;
        padding: 2rem;
        background: linear-gradient(to top, rgba(15,23,42,0.95) 0%, rgba(15,23,42,0) 100%);
        transition: transform 0.4s ease;
    }

    .bento-badge {
        font-family: "Courier New", monospace;
        font-size: 0.9rem;
        color: var(--clr-blue-light);
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    .bento-title {
        font-size: clamp(1.2rem, 3vw, 2rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .bento-desc {
        font-family: "Courier New", monospace;
        color: var(--clr-silver);
        font-size: 0.9rem;
    }

    @media (max-width: 900px) {
        .bento-grid {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
        }
        .highlight, .alt-1, .alt-2 {
            grid-column: 1;
            grid-row: auto;
        }
        .highlight {
            min-height: 400px;
        }
        .alt-1, .alt-2 {
            min-height: 250px;
        }
    }
</style>
