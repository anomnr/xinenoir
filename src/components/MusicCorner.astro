---
// src/components/MusicCorner.astro
// v2.0: Minimalist horizontal scroll-hijack layout

const tracks = [
    {
        id: "01",
        title: "Made In Japan",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896049/-_13_-_made_in_japan_v2.mp4",
        label: "PERFORMANCE"
    },
    {
        id: "02",
        title: "Bukan Cinta Biasa",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896074/Cover_2.mp4",
        label: "COVER"
    },
    {
        id: "03",
        title: "Special Moment",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896055/quote_4.mp4",
        label: "FEATURE"
    },
    {
        id: "04",
        title: "Best Part",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896060/-_12_-_best_part.mp4",
        label: "PERFORMANCE"
    },
    {
        id: "05",
        title: "Rewrite The Stars",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896070/Cover_1.mp4",
        label: "COVER"
    },
    {
        id: "06",
        title: "Fall In Love Again",
        artist: "MAXINE FAYE",
        date: "AUG 2026",
        video: "https://res.cloudinary.com/b8gmaoxd/video/upload/v1786896059/-_14_-_fall_in_love_again_v2.mp4",
        label: "PERFORMANCE"
    }
];
---

<section class="music-section" id="music">
    <!-- Section label -->
    <div class="music-section-header">
        <span class="section-tag">■ XINENOIR ARCHIVES</span>
        <span class="section-tag-sub">MUSIC CORNER</span>
    </div>

    <!-- Horizontal scroll container -->
    <div class="scroll-track" id="musicScrollTrack">
        <div class="scroll-spacer"></div>

        {tracks.map((track) => (
            <div class="album-card">
                <!-- Corner brackets -->
                <div class="bracket tl"></div>
                <div class="bracket tr"></div>
                <div class="bracket bl"></div>
                <div class="bracket br"></div>

                <!-- Vinyl area -->
                <div class="vinyl-area" data-video={track.video}>
                    <div class="vinyl-disc">
                        <div class="vinyl-grooves"></div>
                        <div class="vinyl-hub">
                            <div class="play-glyph">▶</div>
                        </div>
                    </div>
                    <span class="vinyl-badge">{track.label}</span>
                </div>

                <!-- Track meta — minimal -->
                <div class="track-meta">
                    <span class="meta-id">[{track.id}]</span>
                    <div class="meta-text">
                        <span class="meta-title">{track.title}</span>
                        <span class="meta-sub">{track.artist} — {track.date}</span>
                    </div>
                </div>
            </div>
        ))}

        <div class="scroll-spacer"></div>
    </div>

    <!-- Scroll progress indicator -->
    <div class="scroll-progress-track">
        <div class="scroll-progress-bar" id="scrollProgressBar"></div>
    </div>

    <!-- Skip button -->
    <button class="skip-btn" id="skipArchiveBtn" type="button">
        <span class="skip-label">↓ SKIP ARCHIVE ↓</span>
    </button>

    <!-- Video Modal -->
    <div id="globalVideoModal" class="video-modal-overlay hidden">
        <div class="video-modal-content">
            <button class="close-video-btn" id="closeGlobalVideo">&times;</button>
            <video id="globalModalVideo" controls playsinline></video>
        </div>
    </div>
</section>

<style>
    /* ============================
       SECTION WRAPPER
    ============================ */
    .music-section {
        position: relative;
        width: 100%;
        min-height: 100dvh;
        background-color: #000;
        color: var(--clr-white);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 4rem 0 2rem;
        gap: 1.5rem;
    }

    /* ============================
       SECTION HEADER
    ============================ */
    .music-section-header {
        width: 100%;
        max-width: 1200px;
        padding: 0 2rem;
        display: flex;
        align-items: baseline;
        gap: 1rem;
        align-self: flex-start;
        margin-left: max(2rem, calc(50vw - 600px));
    }

    .section-tag {
        font-family: "Courier New", Courier, monospace;
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--clr-blue-light);
        text-transform: uppercase;
    }

    .section-tag-sub {
        font-family: var(--font-body);
        font-size: 11px;
        letter-spacing: 3px;
        color: rgba(255, 255, 255, 0.3);
        text-transform: uppercase;
    }

    /* ============================
       HORIZONTAL SCROLL TRACK
    ============================ */
    .scroll-track {
        display: flex;
        gap: 3rem;
        overflow-x: auto;
        overflow-y: hidden;
        width: 100%;
        padding: 2rem 0;
        align-items: center;
        cursor: grab;

        /* Hide scrollbar */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .scroll-track::-webkit-scrollbar {
        display: none;
    }

    .scroll-track.dragging {
        cursor: grabbing;
        scroll-snap-type: none;
    }

    .scroll-spacer {
        flex: 0 0 auto;
        width: max(2rem, calc(50vw - 160px));
    }

    /* ============================
       ALBUM CARD
    ============================ */
    .album-card {
        flex: 0 0 auto;
        position: relative;
        width: 280px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        border: 1px dashed rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.02);
        transition: border-color 0.4s ease, background 0.4s ease;
    }

    .album-card:hover {
        border-color: rgba(37, 99, 235, 0.3);
        background: rgba(37, 99, 235, 0.03);
    }

    /* Corner brackets */
    .bracket {
        position: absolute;
        width: 14px;
        height: 14px;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .tl { top: -1px; left: -1px; border-right: none; border-bottom: none; }
    .tr { top: -1px; right: -1px; border-left: none; border-bottom: none; }
    .bl { bottom: -1px; left: -1px; border-right: none; border-top: none; }
    .br { bottom: -1px; right: -1px; border-left: none; border-top: none; }

    .album-card:hover .bracket {
        border-color: var(--clr-blue-light);
        width: 22px;
        height: 22px;
    }

    /* ============================
       VINYL DISC
    ============================ */
    .vinyl-area {
        width: 240px;
        height: 240px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        background: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.03) 0%,
            transparent 70%
        );
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .vinyl-area:hover {
        border-color: var(--clr-blue-accent);
        box-shadow: 0 0 30px rgba(37, 99, 235, 0.15);
    }

    .vinyl-disc {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: #111;
        border: 4px solid #1a1a1a;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow:
            0 8px 20px rgba(0, 0, 0, 0.6),
            inset 0 0 15px rgba(255, 255, 255, 0.05);
        transition: transform 0.5s ease;
    }

    .vinyl-grooves {
        position: absolute;
        inset: 8px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow:
            inset 0 0 0 10px rgba(255, 255, 255, 0.02),
            inset 0 0 0 20px rgba(255, 255, 255, 0.015),
            inset 0 0 0 30px rgba(255, 255, 255, 0.01),
            inset 0 0 0 40px rgba(255, 255, 255, 0.005);
    }

    .vinyl-area.playing .vinyl-disc {
        animation: spin 4s linear infinite;
    }

    @keyframes spin {
        100% { transform: rotate(360deg); }
    }

    .vinyl-hub {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--clr-blue-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #000;
        position: relative;
        z-index: 2;
        transition: background 0.3s ease;
    }

    .vinyl-area:hover .vinyl-hub {
        background: var(--clr-blue-light);
    }

    .play-glyph {
        color: #fff;
        font-size: 1rem;
        margin-left: 3px;
        line-height: 1;
    }

    .vinyl-area.playing .play-glyph {
        color: transparent;
    }
    .vinyl-area.playing .play-glyph::before {
        content: "II";
        color: #fff;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.75rem;
        margin-left: -3px;
    }

    .vinyl-badge {
        position: absolute;
        bottom: 12px;
        font-family: "Courier New", Courier, monospace;
        font-size: 10px;
        letter-spacing: 4px;
        color: rgba(255, 255, 255, 0.3);
        text-transform: uppercase;
    }

    /* ============================
       TRACK META (minimal)
    ============================ */
    .track-meta {
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
        padding-top: 0.75rem;
    }

    .meta-id {
        font-family: "Courier New", Courier, monospace;
        font-size: 13px;
        color: var(--clr-blue-light);
        flex-shrink: 0;
        line-height: 1.4;
    }

    .meta-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .meta-title {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: var(--clr-white);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .meta-sub {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.4);
        letter-spacing: 0.3px;
    }

    /* ============================
       SCROLL PROGRESS INDICATOR
    ============================ */
    .scroll-progress-track {
        width: 120px;
        height: 2px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 1px;
        overflow: hidden;
    }

    .scroll-progress-bar {
        height: 100%;
        width: 0%;
        background: var(--clr-blue-accent);
        border-radius: 1px;
        transition: width 0.1s ease-out;
    }

    /* ============================
       SKIP BUTTON
    ============================ */
    .skip-btn {
        background: none;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.4);
        font-family: "Courier New", Courier, monospace;
        font-size: 11px;
        letter-spacing: 3px;
        padding: 0.6rem 2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border-radius: 0;
        text-transform: uppercase;
    }

    .skip-btn:hover {
        color: var(--clr-blue-light);
        border-color: var(--clr-blue-light);
        background: rgba(37, 99, 235, 0.05);
    }

    .skip-btn:active {
        transform: scale(0.98);
    }

    .skip-label {
        pointer-events: none;
    }

    /* ============================
       VIDEO MODAL
    ============================ */
    .video-modal-overlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        transition: opacity 0.3s ease;
    }

    .video-modal-overlay.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .video-modal-content {
        position: relative;
        width: 80%;
        height: 80%;
        max-width: 1000px;
        background: #000;
        border-radius: var(--radius-global);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transform: scale(1);
        transition: transform 0.3s ease;
    }

    .video-modal-overlay.hidden .video-modal-content {
        transform: scale(0.95);
    }

    #globalModalVideo {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .close-video-btn {
        position: absolute;
        top: 12px;
        right: 16px;
        background: rgba(0, 0, 0, 0.6);
        color: var(--clr-white);
        border: 1px solid rgba(255, 255, 255, 0.15);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 1.25rem;
        cursor: pointer;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        backdrop-filter: blur(4px);
    }

    .close-video-btn:hover {
        background: var(--clr-blue-accent);
        border-color: var(--clr-blue-accent);
        transform: scale(1.1);
    }

    /* ============================
       RESPONSIVE
    ============================ */
    @media (max-width: 600px) {
        .music-section {
            padding: 3rem 0 1.5rem;
        }

        .music-section-header {
            margin-left: 1rem;
            padding: 0 1rem;
        }

        .album-card {
            width: 260px;
            padding: 1.25rem;
        }

        .vinyl-area {
            width: 220px;
            height: 220px;
        }

        .vinyl-disc {
            width: 140px;
            height: 140px;
        }

        .scroll-spacer {
            width: 1rem;
        }

        .scroll-track {
            gap: 2rem;
        }
    }
</style>

<script>
    // === DOM References ===
    const track = document.getElementById('musicScrollTrack');
    const progressBar = document.getElementById('scrollProgressBar');
    const skipBtn = document.getElementById('skipArchiveBtn');
    const section = document.getElementById('music');

    if (track) {
        // === Scroll Progress ===
        function updateProgress() {
            if (!track || !progressBar) return;
            const maxScroll = track.scrollWidth - track.clientWidth;
            if (maxScroll <= 0) {
                progressBar.style.width = '100%';
                return;
            }
            const pct = (track.scrollLeft / maxScroll) * 100;
            progressBar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
        }

        track.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        // === Scroll Hijacking (wheel → horizontal) ===
        track.addEventListener('wheel', function (e) {
            const maxScroll = track.scrollWidth - track.clientWidth;
            if (maxScroll <= 0) return; // Nothing to scroll

            const atLeft = track.scrollLeft <= 0;
            const atRight = track.scrollLeft >= maxScroll - 1;

            // Release scroll to page if at boundary and scrolling further in that direction
            if ((atLeft && e.deltaY < 0) || (atRight && e.deltaY > 0)) {
                return; // Let the page scroll normally
            }

            // Hijack: convert vertical scroll to horizontal
            e.preventDefault();
            track.scrollLeft += e.deltaY;
        }, { passive: false });

        // === Mouse Drag ===
        let isDown = false;
        let isDragging = false;
        let startX;
        let scrollLeft;

        track.addEventListener('mousedown', (e) => {
            isDown = true;
            isDragging = false;
            track.classList.add('dragging');
            startX = e.pageX - track.offsetLeft;
            scrollLeft = track.scrollLeft;
        });

        track.addEventListener('mouseleave', () => {
            isDown = false;
            track.classList.remove('dragging');
        });

        track.addEventListener('mouseup', () => {
            isDown = false;
            track.classList.remove('dragging');
        });

        track.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            isDragging = true;
            e.preventDefault();
            const x = e.pageX - track.offsetLeft;
            const walk = (x - startX) * 1.5;
            track.scrollLeft = scrollLeft - walk;
        });

        // === Video Modal Logic ===
        const playBtns = document.querySelectorAll('.vinyl-area');
        const modal = document.getElementById('globalVideoModal');
        const modalVideo = document.getElementById('globalModalVideo');
        const closeBtn = document.getElementById('closeGlobalVideo');

        playBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                if (isDragging) return;

                const videoSrc = btn.getAttribute('data-video');
                if (videoSrc && modal && modalVideo) {
                    modalVideo.src = videoSrc;
                    modal.classList.remove('hidden');
                    modalVideo.play().catch(e => console.log('Autoplay prevented', e));
                }
            });
        });

        function closeModal() {
            if (modal && modalVideo) {
                modal.classList.add('hidden');
                modalVideo.pause();
                modalVideo.src = '';
            }
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', closeModal);
        }

        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
        }
    }

    // === Skip Button ===
    if (skipBtn) {
        skipBtn.addEventListener('click', () => {
            // Scroll to the next section after #music (which is #countdown)
            const nextSection = section?.nextElementSibling;
            if (nextSection) {
                nextSection.scrollIntoView({ behavior: 'smooth' });
            } else {
                // Fallback: scroll down by one viewport height
                window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
            }
        });
    }
</script>
