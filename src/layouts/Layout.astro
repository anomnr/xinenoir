<style is:global>
    :root {
        /* Colors */
        --clr-deep-navy: #0f172a;
        --clr-blue-accent: #2563eb;
        --clr-blue-light: #60a5fa;
        --clr-white: #ffffff;
        --clr-silver: #9ca3af;
        
        /* Shape Lock */
        --radius-global: 12px;
    }

    /* Base Resets */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        background-color: var(--clr-deep-navy);
        color: var(--clr-white);
        font-family: "Poppins", sans-serif;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
    }

    /* SVG Noise Overlay */
    .noise-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9999;
        opacity: 0.04;
    }

    /* Global Typography Resets */
    h1, h2, h3, h4, h5, h6 {
        line-height: 1.1;
    }
    
    a, button {
        transition: all 0.3s ease;
    }
    
    /* Tactile Feedback for all interactive elements */
    a:active, button:active {
        transform: scale(0.98);
    }

    /* Custom Scrollbar for Cyber Aesthetic */
    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        background: #000;
    }
    ::-webkit-scrollbar-thumb {
        background: var(--clr-blue-accent);
        border-radius: var(--radius-global);
    }
    ::-webkit-scrollbar-thumb:hover {
        background: var(--clr-blue-light);
    }
    
    /* Selection */
    ::selection {
        background: var(--clr-blue-light);
        color: #000;
    }
</style>
